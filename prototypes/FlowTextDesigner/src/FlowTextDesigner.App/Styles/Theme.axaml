<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.ribbon">
    <Setter Property="Background" Value="#202733" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style Selector="Border.property-panel">
    <Setter Property="Background" Value="#1F1F1F" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.tabs-bar">
    <Setter Property="Background" Value="#222" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Border.canvas-root">
    <Setter Property="Background" Value="#0F1218" />
    <Setter Property="Padding" Value="8" />
  </Style>
</Styles>
